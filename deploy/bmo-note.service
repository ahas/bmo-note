# Generated from bmo-app.toml by bmo-app-sdk's bmo-app-declare.
# The bmo-note service, run from its deploy tree.
[Unit]
Description=bmo-note: editable BlockSuite notes kept as binary documents, shown in the console
After=network-online.target
# Without its deployed settings the service has no credential, so it does not
# start where the deployment wrote none.
ConditionPathExists=%h/.local/share/bmo/data/env/note.toml

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-note/deploy
ExecStart=%h/.local/share/bmo-note/deploy/bin/bmo-note serve
Restart=always
RestartSec=2
# A stop waits for the service to end on its own, however long its open streams and
# in-hand requests take; it is never escalated to a kill.
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
# The repository's one service: stopped, restarted and watched by every deployment, which waits on its health.
X-BMO-Deploy=bot
